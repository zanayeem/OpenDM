{
  "manifest_version": 3,
  "name": "OpenDM Integration",
  "version": "1.0.0",
  "description": "Send browser downloads to the OpenDM download manager for faster, resumable, multi-connection downloads.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "OpenDM",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "contextMenus", "storage", "cookies"],
  "host_permissions": ["<all_urls>"]
}
